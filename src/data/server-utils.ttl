@prefix server-utils: <https://linked.cm/ont/server-utils/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .

server-utils:
    a owl:Ontology ;
    dcterms:description "Terms of the utilities shared by the Linked server and its clients."@en ;
    dcterms:title "Linked server utilities"@en ;
    owl:versionInfo "1.14.1" .

server-utils:Lincd_API_Client
    a owl:Class ;
    rdfs:comment "A client for a Linked web app's data API, which posts select, update, create and delete queries to <uri>/<method>."@en ;
    rdfs:isDefinedBy server-utils: ;
    rdfs:label "Linked API client"@en .
