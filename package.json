{
  "name": "@_linked/server-utils",
  "description": "",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/server-utils.git"
  },
  "version": "1.12.3",
  "packageManager": "npm@12.1.0",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "linked": {
    "serverOnly": [
      "./utils/CallContext",
      "./utils/QueryAccess"
    ]
  },
  "license": "ISC",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "npm run test:unit && npm run test:calls",
    "test:unit": "jest --config jest.config.cjs",
    "test:calls": "node --test 'test/*.test.mjs'"
  },
  "keywords": [
    "lincd",
    "linked data",
    "interoperable",
    "semantic web",
    "web3"
  ],
  "dependencies": {
    "@_linked/core": "^2.22.8",
    "formidable": "^3.5.1",
    "react-router-dom": "^7.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
